{
  "name": "my-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "comments:check": "node scripts/check-function-comments.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "modules:check": "node --experimental-vm-modules scripts/check-client-assets.mjs",
    "build": "npm run lint && npm run comments:check && npm run docs:check && npm run modules:check"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.9"
  }
}
